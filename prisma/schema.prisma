generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          Role      @default(STUDENT)
  password         String?
  isRestricted     Boolean   @default(false)
  pushSubscription String?   // legacy single-device field (kept for reference)
  pricePer20Min      Int?      // ₪ instructor sets per student; null = not priced yet
  idNumber           String?   // ת"ז
  dateOfBirth        DateTime?
  manualPriorLessons Float     @default(0) // lessons completed before this platform (quarter-lesson precision), entered by the instructor
  manualPriorOtherTeacherLessons Float @default(0) // lessons completed with a different instructor before this one (quarter-lesson precision) — distinct from manualPriorLessons (previous platform, same instructor), both count toward the total
  manualPriorPracticalTests Int @default(0) // מבחנים מעשיים done before this platform, for the student card report only
  manualPriorInternalTests  Int @default(0) // טסטים פנימיים done before this platform, for the student card report only
  previousPlatformDebt Int @default(0) // ₪ still owed from the previous platform — decremented as it's paid off, never tied to a real lesson/charge
  archivedAt         DateTime? // "deleted" students are archived, not removed — past lessons must stay in the calendar/history
  createdAt          DateTime  @default(now())

  // Privacy Protection Law (Amendment 13) — informed consent at account
  // creation isn't possible for students the instructor registers on their
  // behalf, so this is also captured via a one-time gate on first login.
  privacyConsentAt    DateTime?
  // Login throttling — reset on a successful login or a password reset.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  accounts            Account[]
  sessions            Session[]
  bookings            Booking[] @relation("StudentBookings")
  availability        Availability[]
  pushSubscriptions   PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  invoices            Invoice[]
  payments            Payment[]
  charges             Charge[]
  manualLessonRecords ManualLessonRecord[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  payload   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  INSTRUCTOR
  STUDENT
}

model Availability {
  id           String   @id @default(cuid())
  instructorId String
  instructor   User     @relation(fields: [instructorId], references: [id])
  startTime    DateTime
  endTime      DateTime
  isBooked     Boolean  @default(false)
  isBlocked       Boolean  @default(false)
  blockNote       String?
  calendarEventId String?
  publishAt       DateTime?
  createdAt       DateTime @default(now())

  bookings Booking[]

  @@index([startTime])
  @@index([isBooked, isBlocked, startTime])
}

model Booking {
  id             String        @id @default(cuid())
  studentId      String
  student        User          @relation("StudentBookings", fields: [studentId], references: [id])
  // Not unique — a slot's history can hold more than one Booking over time
  // (a cancelled/rejected row kept for its payment history, plus whichever
  // booking is actually active now), so creating or moving a booking into a
  // slot that was once used never has to delete that old row first.
  availabilityId String
  availability   Availability  @relation(fields: [availabilityId], references: [id])
  status           BookingStatus @default(PENDING)
  notes            String?
  pickupAddress    String?
  alternativeSlots  Json?
  reminderSent      Boolean       @default(false)
  calendarEventId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments Payment[]

  @@index([availabilityId])
  @@index([studentId, status])
  @@index([status, createdAt])
  @@index([reminderSent, status])
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  BIT
  PAYBOX
  BANK_TRANSFER
  BALANCE  // settled from the student's prepaid credit — no new Morning document
  EXTERNAL // already paid/invoiced outside this system (e.g. the previous platform) — no new Morning document
}

// One Morning document. Covers 1+ lessons (a regular or batched invoice), a
// bare balance top-up (isDeposit true, no lessons attached), or a one-off
// charge unrelated to any lesson (e.g. test car provision — `description`
// set, isDeposit false, no Payments attached either).
model Invoice {
  id            String        @id @default(cuid())
  studentId     String
  student       User          @relation(fields: [studentId], references: [id])
  amount        Int           // ₪ total, what the instructor confirmed
  method        PaymentMethod // never BALANCE — a deposit/invoice is always real money in
  reference     String?       // confirmation #, sender name, phone used for Bit/PayBox, etc.
  description   String?       // set for one-off charges not tied to a lesson; null = lesson invoice/deposit
  paidAt        DateTime
  isDeposit     Boolean       @default(false)
  invoiceId     String?       // Morning document id
  invoiceNumber String?
  invoiceUrl    String?
  createdAt     DateTime      @default(now())

  payments Payment[]
  charge   Charge?

  @@index([studentId])
}

// How one specific lesson got settled — linked to an Invoice, or (for
// method = BALANCE) drawn straight from the student's prepaid credit with
// no Invoice of its own, since that money was already invoiced at deposit time.
model Payment {
  id        String        @id @default(cuid())
  bookingId String        // first booking id of the lesson chain — not unique:
                          // a lesson can be settled across multiple partial
                          // payments, so may have more than one Payment row
  booking   Booking       @relation(fields: [bookingId], references: [id])
  studentId String
  student   User          @relation(fields: [studentId], references: [id])
  amount    Int           // ₪ — this lesson's confirmed share
  method    PaymentMethod
  invoiceId String?       // null only when method = BALANCE
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id])
  paidAt    DateTime
  createdAt DateTime      @default(now())

  @@index([studentId])
  @@index([invoiceId])
  @@index([bookingId])
}

enum ChargeType {
  PRACTICAL_TEST // מבחן מעשי
  INTERNAL_TEST  // טסט פנימי
}

// A calendar event booked directly with a student that isn't a driving
// lesson — a practical/internal test — with its own fixed cost. Shown on
// the calendar in its own color; stays unpaid (contributing to the
// student's debt) until the instructor links it to a real Invoice.
model Charge {
  id        String     @id @default(cuid())
  studentId String
  student   User       @relation(fields: [studentId], references: [id])
  type      ChargeType
  startTime DateTime
  endTime   DateTime
  amount    Int
  invoiceId String?    @unique
  invoice   Invoice?   @relation(fields: [invoiceId], references: [id])
  calendarEventId String?
  passed    Boolean?   // for a practical test: true=עבר, false=נכשל, null=still unknown
  createdAt DateTime   @default(now())

  @@index([studentId])
  @@index([startTime])
}

// One lesson that happened on the previous platform, entered by hand so the
// student's full history (not just a single carried-over count) can show up
// in the student card report — a date, how many lesson-units it was, and
// what was paid for it, if known.
model ManualLessonRecord {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  date       DateTime
  lessons    Float
  amountPaid Int?
  createdAt  DateTime @default(now())

  @@index([studentId])
}

// Audit trail for the Privacy Protection Law (Data Security Regulations) —
// logins, lockouts and consent events. No FK to User: a security log must
// survive independently of whatever happens to the account it's about.
model SecurityLog {
  id        String   @id @default(cuid())
  type      String   // LOGIN_SUCCESS | LOGIN_FAILURE | LOGIN_LOCKED | PRIVACY_CONSENT
  userId    String?
  email     String?
  ip        String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
